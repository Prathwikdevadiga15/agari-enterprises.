# AGARI ENTERPRISES — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate the secrets.
# Never commit real credentials or .env.local to Git.

# AI Chatbot Assistant (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Admin Dashboard Access Token
ADMIN_TOKEN=agari-admin-secure-token-change-in-production

# PostgreSQL Database (Prisma ORM / Supabase / Neon)
DATABASE_URL=postgresql://username:password@localhost:5432/agari_db?schema=public

# Optional Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# Site URL & Public Metadata
NEXT_PUBLIC_APP_URL=https://agari-nextjs.vercel.app
NEXT_PUBLIC_SITE_NAME="Agari Enterprises"
